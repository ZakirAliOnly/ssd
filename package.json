{
  "name": "ssd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:upgrade:returns": "prisma db execute --file scripts/migration-v33-invoice-returns.sql --schema prisma/schema.prisma",
    "db:upgrade:inventory": "node scripts/upgrade-inventory.cjs",
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "prebuild": "prisma generate",
    "db:upgrade:decimal-quantities": "prisma db execute --file scripts/migration-v32-decimal-quantities.sql --schema prisma/schema.prisma",
    "db:upgrade:item-discounts": "prisma db execute --file scripts/migration-v31-invoice-item-discount.sql --schema prisma/schema.prisma",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:upgrade:products": "prisma db execute --file scripts/migration-v25-product-categories.sql --schema prisma/schema.prisma",
    "db:upgrade:stock": "prisma db execute --file scripts/migration-v26-product-stock.sql --schema prisma/schema.prisma",
    "db:upgrade:expiry": "prisma db execute --file scripts/migration-v27-product-expiry.sql --schema prisma/schema.prisma",
    "db:upgrade:purchases": "prisma db execute --file scripts/migration-v28-purchase-product-expiry.sql --schema prisma/schema.prisma",
    "db:upgrade:users": "prisma db execute --file scripts/migration-v29-user-modules.sql --schema prisma/schema.prisma",
    "db:upgrade:batches": "prisma db execute --file scripts/migration-v30-stock-batches.sql --schema prisma/schema.prisma",
    "db:studio": "prisma studio",
    "create:admin": "node --env-file=.env scripts/create-admin.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "html2canvas": "^1.4.1",
    "jose": "^5.10.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.0.1",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
