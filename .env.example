# S.S.D — environment variables
# Copy this file to .env and fill in the values.

# PostgreSQL connection string (local Postgres via pgAdmin on Hostinger VPS)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ssd"

# JWT secret — generate a strong random string (e.g. openssl rand -base64 32)
JWT_SECRET="change-me-to-a-strong-random-secret"

# For creating the first admin user (npm run create:admin)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_BEFORE_CREATING_ADMIN"
ADMIN_LOCATION="quetta"

# Optional WhatsApp connection using Baileys (see docs/whatsapp-setup.md)
# Required only for the WhatsApp worker. Keep stable and store securely:
# WHATSAPP_AUTH_ENCRYPTION_KEY= # 64 hex characters; generate with openssl rand -hex 32
# Optional HTTPS/WebSocket proxy; omit on normal VPS deployments:
# WHATSAPP_PROXY_URL=http://your-proxy:port
